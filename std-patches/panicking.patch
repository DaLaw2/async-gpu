+            // On GPU (nvptx64/CUDA), include block/warp/lane metadata instead of
+            // a plain OS thread ID.  This makes panic output on GPU indistinguishable
+            // from CPU panics except for the richer thread identification.
+            #[cfg(target_os = "cuda")]
