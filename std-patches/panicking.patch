+/// Read GPU block index (x) and thread index (x) via inline PTX assembly.
+///
+/// Returns `(blockIdx.x, threadIdx.x)`.  The caller can derive:
+///   - warp  = threadIdx.x / 32
+///   - lane  = threadIdx.x % 32
+///
+/// Only compiled on `target_os = "cuda"` (nvptx64).
+#[cfg(target_os = "cuda")]
+#[inline(always)]
+fn gpu_panic_indices() -> (u32, u32) {
+    let block_x: u32;
+    let thread_x: u32;
+    unsafe {
+        core::arch::asm!(
+            "mov.u32 {bx}, %ctaid.x;",
+            "mov.u32 {tx}, %tid.x;",
+            bx = out(reg32) block_x,
+            tx = out(reg32) thread_x,
+        );
+    }
+    (block_x, thread_x)
+}
+
 /// The default panic handler.
